# Root environment reference (copy relevant sections to api/.env and web/.env)

# API
APP_NAME=Astro Kovesh API
APP_ENV=development
APP_HOST=0.0.0.0 # https://astro-kovesh-api.vercel.app/
APP_PORT=8010
FRONTEND_URL=http://localhost:5173 # https://astro-kovesh-web.vercel.app
CORS_ORIGINS=http://localhost:5173 # https://astro-kovesh-web.vercel.app
REQUEST_TIMEOUT_SECONDS=8
DEFAULT_TIMEZONE=UTC
GEOCODER_USER_AGENT=astro-kovesh/0.1
GEOCODER_CALLS_PER_MINUTE=30
GEOCODER_MIN_SECONDS_BETWEEN_CALLS=1
IP_RATE_LIMIT_PER_MINUTE=60

# WEB
VITE_API_BASE_URL=http://localhost:8010 # https://astro-kovesh-api.vercel.app
